# kulinar.app — public_html
# Laravel (~/api) renderira javni dio sajta (/, /recepti, /kalkulatori, /vodici...) i /api.
# Flutter web aplikacija je u podfolderu /app (build s --base-href /app/).
DirectoryIndex index.php index.html
Options -MultiViews -Indexes

<IfModule mod_headers.c>
  <FilesMatch "^(index\.html|flutter_bootstrap\.js|flutter_service_worker\.js)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Flutter web aplikacija: sve pod /app/ sto nije stvarna datoteka -> /app/index.html
  RewriteRule ^app$ /app/ [R=301,L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^app/ app/index.html [L]

  # Postojece datoteke (slike, ads.txt, storage, ikone) normalno
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Sve ostalo (/, /recepti, /api, /sitemap.xml, 404...) -> Laravel
  RewriteRule ^ index.php [L]
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php84” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php84 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
